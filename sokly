            System.out.println("6. Logout");
            System.out.print("Choose an option: ");
            int choice = scanner.nextInt();
            scanner.nextLine(); // Clear buffer
            switch (choice) {
                case 1:
                    student.viewAttendance();
                    break;
                case 2:
                    double percentage = student.calculateAttendancePercentage();
                    System.out.println("Your attendance percentage is: " + percentage + "%");
                    break;
                case 3:
                    System.out.print("Enter date (yyyy-MM-dd): ");
                    String date = scanner.nextLine();
                    System.out.print("Enter reason for leave: ");
                    String reason = scanner.nextLine();
                    student.submitLeaveRequest(date, reason);
                    break;
                case 4:
                    System.out.print("Enter new name: ");
                    String newName = scanner.nextLine();
                    student.updateProfile(newName);
                    break;
                case 5:
                    System.out.print("Enter old password: ");
                    String oldPassword = scanner.nextLine();
                    System.out.print("Enter new password: ");
                    String newPassword = scanner.nextLine();
                    student.changePassword(oldPassword, newPassword);
                    break;
                case 6:
                    student.logout();
                    currentUser = null;
                    return;
                default:
                    System.out.println("Invalid option. Please try again.");
            }
        }
    }
}
