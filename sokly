        super(userId, name, "Admin", username, password);
        this.adminId = adminId;
        this.students = new ArrayList<>();
        this.teachers = new ArrayList<>();
    }

    // Getters and Setters
    public int getAdminId() { return adminId; }
    public void setAdminId(int adminId) { this.adminId = adminId; }
    public List<Student> getAllStudents() { return students; }
    public List<Teacher> getAllTeachers() { return teachers; }

    // User Management Methods
    public void addStudent(Student student) {
        students.add(student);
        System.out.println("Student " + student.getName() + " added successfully.");
    }

    public void addTeacher(Teacher teacher) {
        teachers.add(teacher);
        System.out.println("Teacher " + teacher.getName() + " added successfully.");
    }

    public void updateStudent(Student student, String newName, String newClass) {
        student.updateProfile(newName);
        student.setClassName(newClass);
