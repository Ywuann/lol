// Abstract User Class
abstract class User {
    protected int userId;
    protected String name;
    protected String role;
    protected String username;
    protected String password;

    public User(int userId, String name, String role, String username, String password) {
        this.userId = userId;
        this.name = name;
        this.role = role;
        this.username = username;
        this.password = password;
    }

    // Getters and Setters
    public int getUserId() { return userId; }
    public void setUserId(int userId) { this.userId = userId; }
    public String getName() { return name; }
    public void setName(String name) { this.name = name; }
    public String getRole() { return role; }
    public void setRole(String role) { this.role = role; }
    public String getUsername() { return username; }
    public void setUsername(String username) { this.username = username; }
    public String getPassword() { return password; }
    public void setPassword(String password) { this.password = password; }

    // Common Methods
    public boolean login(String username, String password) {
        return this.username.equals(username) && this.password.equals(password);
    }

    public void logout() {
        System.out.println(name + " has logged out.");
    }

    public void updateProfile(String newName) {
        this.name = newName;
        System.out.println("Profile updated successfully.");
    }

    public void changePassword(String oldPassword, String newPassword) {
        if (this.password.equals(oldPassword)) {
            this.password = newPassword;
            System.out.println("Password changed successfully.");
        } else {
            System.out.println("Incorrect old password.");
        }
    }
}

// Student Class
class Student extends User {
    private int studentId;
    private String className;
    private List<Attendance> attendanceRecords;

    public Student(int userId, String name, String username, String password, int studentId, String className) {
        super(userId, name, "Student", username, password);
        this.studentId = studentId;
        this.className = className;
        this.attendanceRecords = new ArrayList<>();
    }

    // Getters and Setters
    public int getStudentId() { return studentId; }
    public void setStudentId(int studentId) { this.studentId = studentId; }
    public String getClassName() { return className; }
    public void setClassName(String className) { this.className = className; }
    public List<Attendance> getAttendanceRecords() { return attendanceRecords; }

    // Attendance Management Methods
    public void viewAttendance() {
        if (attendanceRecords.isEmpty()) {
            System.out.println("No attendance records available.");
            return;
        }
        System.out.println("Attendance records for " + name + ":");
        for (Attendance attendance : attendanceRecords) {
            System.out.println("Date: " + attendance.getDate() + ", Status: " + attendance.getStatus());
        }
    }

    public double calculateAttendancePercentage() {
        if (attendanceRecords.isEmpty()) return 0.0;
        int presentCount = 0;
        for (Attendance attendance : attendanceRecords) {
            if (attendance.getStatus().equalsIgnoreCase("Present")) presentCount++;
        }
        return (double) presentCount / attendanceRecords.size() * 100;
    }

    public void submitLeaveRequest(String date, String reason) {
        System.out.println("Leave request submitted for " + date + ". Reason: " + reason);
    }

    public void addAttendanceRecord(Attendance attendance) {
        attendanceRecords.add(attendance);
    }
}

// Teacher Class
class Teacher extends User {
    private int teacherId;
    private String subject;

    public Teacher(int userId, String name, String username, String password, int teacherId, String subject) {
        super(userId, name, "Teacher", username, password);
        this.teacherId = teacherId;
        this.subject = subject;
    }

    // Getters and Setters
    public int getTeacherId() { return teacherId; }
    public void setTeacherId(int teacherId) { this.teacherId = teacherId; }
    public String getSubject() { return subject; }
    public void setSubject(String subject) { this.subject = subject; }

    // Attendance Management Methods
    public void markAttendance(Student student, String date, String status) {
        if (!isValidDate(date)) {
            System.out.println("Invalid date format. Please use yyyy-MM-dd.");
            return;
        }
        Attendance attendance = new Attendance(0, student.getStudentId(), date, status);
        student.addAttendanceRecord(attendance);
        System.out.println("Attendance marked for " + student.getName() + " on " + date + ": " + status);
    }

    public void updateAttendance(Student student, String date, String newStatus) {
        if (!isValidDate(date)) {
            System.out.println("Invalid date format. Please use yyyy-MM-dd.");
            return;
        }
        List<Attendance> records = student.getAttendanceRecords();
        for (Attendance record : records) {
            if (record.getDate().equals(date)) {
                record.setStatus(newStatus);
                System.out.println("Attendance updated for " + student.getName() + " on " + date + ": " + newStatus);
                return;
            }
        }
        System.out.println("No attendance record found for that date.");
    }

    public void viewStudentAttendance(Student student) {
        System.out.println("Attendance records for " + student.getName() + ":");
        student.viewAttendance();
    }

    public void approveLeaveRequest(Student student, String date) {
        System.out.println("Leave request approved for " + student.getName() + " on " + date);
    }

    public void rejectLeaveRequest(Student student, String date, String reason) {
        System.out.println("Leave request rejected for " + student.getName() + " on " + date + ". Reason: " + reason);
    }

    private boolean isValidDate(String date) {
        try {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
            LocalDate.parse(date, formatter);
            return true;
        } catch (Exception e) {
            return false;
        }
    }
}

// Admin Class
class Admin extends User {
